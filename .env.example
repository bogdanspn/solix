# Written automatically by `npm run probe` - you should not need to edit this
# by hand. Every value here is a placeholder.

# Solarbank. Left blank, the server sweeps the LAN at startup and fills it in.
SOLIX_HOST=192.168.1.50
SOLIX_PORT=502
SOLIX_UNIT_ID=1
# holding = FC3, input = FC4
SOLIX_REGISTER_KIND=holding
# Set to 1 if the probe finds the device reports the opposite sign
SOLIX_INVERT_BATTERY=0
SOLIX_INVERT_GRID=0

# Smart Plugs, comma separated. Refreshed by the Rescan button.
SOLIX_PLUGS=

# Which /24s to scan for devices, comma separated (192.168.3).
# Empty means every non-virtual interface on this host.
SOLIX_SUBNETS=

# Smart Meter, if one is on the LAN. Only with a meter are the grid and load
# registers real house measurements.
SOLIX_METER=

# Dashboard
HTTP_HOST=0.0.0.0
HTTP_PORT=8787
POLL_INTERVAL_MS=5000
PERSIST_INTERVAL_MS=30000
